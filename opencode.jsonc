{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/glm-5.3-flash",
  "small_model": "opencode-go/deepseek-v4-flash",

  "subagent_depth": 2,
  "default_agent": "plan",

  "agent": {
    "plan": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "permissions": {
        "file": "ask",
        "bash": "ask"
      }
    },
    "build": {
      "model": "opencode-go/glm-5.3-flash",
      "permissions": {
        "file": "allow",
        "bash": "allow"
      }
    },
    "general": {
      "model": "opencode-go/glm-5.3-flash"
    }
  },

  "tools": {
    "write": true,
    "bash": true
  }
}
