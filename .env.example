# Copy to .env (never commit). chmod 600 .env.
GEMINI_API_KEY=
SKINMAKER_TRANSPORT=gemini
SKINMAKER_PARSING=1
# Per-skin website editor kill switch. 0 disables job creation, /edit, and the
# job APIs; generation and skins keep working.
SKINMAKER_JOB_EDITOR=1

# Public demo guards (implemented in backend/app.py).
SKINMAKER_RATE_LIMIT_PER_MIN=6
SKINMAKER_MAX_UPLOAD_MB=15
SKINMAKER_RETENTION_DAYS=14
