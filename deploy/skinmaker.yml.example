# Copy to ~/.cloudflared/skinmaker.yml and replace <TUNNEL_UUID>.
# `cloudflared tunnel create skinmaker` prints the UUID and writes the
# credentials file next to this config.
tunnel: <TUNNEL_UUID>
credentials-file: /home/achi/.cloudflared/<TUNNEL_UUID>.json

ingress:
  - hostname: skin.achijaser.date
    service: http://127.0.0.1:8001
  - service: http_status:404
